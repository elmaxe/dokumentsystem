{
  "openapi": "3.1.1",
  "info": {
    "title": "Dokumentsystem API",
    "version": "1.0.0"
  },
  "paths": {
    "/api/v1/server/info": {
      "get": {
        "tags": [
          "Server"
        ],
        "operationId": "GetServerInfo",
        "responses": {
          "200": {
            "description": "OK",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ServerInfo"
                }
              }
            }
          }
        }
      }
    },
    "/api/v1/auth/config": {
      "get": {
        "tags": [
          "Auth"
        ],
        "operationId": "GetAuthConfig",
        "responses": {
          "200": {
            "description": "OK",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/AuthConfig"
                }
              }
            }
          }
        }
      }
    },
    "/api/v1/auth/login": {
      "get": {
        "tags": [
          "Auth"
        ],
        "description": "Starts the OIDC login in the browser. Navigate here; don't fetch it.",
        "operationId": "Login",
        "parameters": [
          {
            "name": "returnTo",
            "in": "query",
            "schema": {
              "type": "string"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "OK"
          }
        }
      }
    },
    "/api/v1/auth/session": {
      "get": {
        "tags": [
          "Auth"
        ],
        "operationId": "GetSession",
        "responses": {
          "200": {
            "description": "OK",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/CurrentSession"
                }
              }
            }
          }
        }
      }
    },
    "/api/v1/auth/logout": {
      "post": {
        "tags": [
          "Auth"
        ],
        "operationId": "Logout",
        "responses": {
          "204": {
            "description": "No Content"
          }
        }
      }
    },
    "/api/v1/sessions": {
      "get": {
        "tags": [
          "Sessions"
        ],
        "operationId": "ListSessions",
        "responses": {
          "200": {
            "description": "OK",
            "content": {
              "application/json": {
                "schema": {
                  "type": "array",
                  "items": {
                    "$ref": "#/components/schemas/SessionInfo"
                  }
                }
              }
            }
          }
        }
      }
    },
    "/api/v1/sessions/{id}": {
      "delete": {
        "tags": [
          "Sessions"
        ],
        "operationId": "RevokeSession",
        "parameters": [
          {
            "name": "id",
            "in": "path",
            "required": true,
            "schema": {
              "type": "string",
              "format": "uuid"
            }
          }
        ],
        "responses": {
          "204": {
            "description": "No Content"
          },
          "404": {
            "description": "Not Found"
          }
        }
      }
    },
    "/api/v1/admin/users/{userId}/sessions": {
      "get": {
        "tags": [
          "Admin"
        ],
        "operationId": "AdminListUserSessions",
        "parameters": [
          {
            "name": "userId",
            "in": "path",
            "required": true,
            "schema": {
              "type": "string",
              "format": "uuid"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "OK",
            "content": {
              "application/json": {
                "schema": {
                  "type": "array",
                  "items": {
                    "$ref": "#/components/schemas/SessionInfo"
                  }
                }
              }
            }
          }
        }
      }
    },
    "/api/v1/admin/sessions/{id}": {
      "delete": {
        "tags": [
          "Admin"
        ],
        "operationId": "AdminRevokeSession",
        "parameters": [
          {
            "name": "id",
            "in": "path",
            "required": true,
            "schema": {
              "type": "string",
              "format": "uuid"
            }
          }
        ],
        "responses": {
          "204": {
            "description": "No Content"
          },
          "404": {
            "description": "Not Found"
          }
        }
      }
    }
  },
  "components": {
    "schemas": {
      "AuthConfig": {
        "required": [
          "enabled",
          "providerName"
        ],
        "type": "object",
        "properties": {
          "enabled": {
            "type": "boolean"
          },
          "providerName": {
            "type": [
              "null",
              "string"
            ]
          }
        }
      },
      "CurrentSession": {
        "required": [
          "user",
          "sessionId",
          "csrfToken"
        ],
        "type": "object",
        "properties": {
          "user": {
            "$ref": "#/components/schemas/UserProfile"
          },
          "sessionId": {
            "type": "string",
            "format": "uuid"
          },
          "csrfToken": {
            "type": [
              "null",
              "string"
            ]
          }
        }
      },
      "ServerInfo": {
        "required": [
          "name",
          "version"
        ],
        "type": "object",
        "properties": {
          "name": {
            "type": "string"
          },
          "version": {
            "type": "string"
          }
        }
      },
      "SessionInfo": {
        "required": [
          "id",
          "kind",
          "deviceName",
          "createdAt",
          "lastSeenAt",
          "current"
        ],
        "type": "object",
        "properties": {
          "id": {
            "type": "string",
            "format": "uuid"
          },
          "kind": {
            "$ref": "#/components/schemas/SessionKind"
          },
          "deviceName": {
            "type": [
              "null",
              "string"
            ]
          },
          "createdAt": {
            "type": "string",
            "format": "date-time"
          },
          "lastSeenAt": {
            "type": "string",
            "format": "date-time"
          },
          "current": {
            "type": "boolean"
          }
        }
      },
      "SessionKind": {
        "enum": [
          "cookie",
          "bearer"
        ]
      },
      "UserProfile": {
        "required": [
          "id",
          "displayName",
          "email",
          "role"
        ],
        "type": "object",
        "properties": {
          "id": {
            "type": "string",
            "format": "uuid"
          },
          "displayName": {
            "type": "string"
          },
          "email": {
            "type": [
              "null",
              "string"
            ]
          },
          "role": {
            "$ref": "#/components/schemas/UserRole"
          }
        }
      },
      "UserRole": {
        "enum": [
          "user",
          "admin"
        ]
      }
    }
  },
  "tags": [
    {
      "name": "Server"
    },
    {
      "name": "Auth"
    },
    {
      "name": "Sessions"
    },
    {
      "name": "Admin"
    }
  ]
}