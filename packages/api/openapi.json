                    "$ref": "#/components/schemas/SessionInfo"
                  }
                }
              }
            }
          }
        }
      }
    },
    "/api/v1/admin/sessions/{id}": {
      "delete": {
        "tags": [
          "Admin"
        ],
        "operationId": "AdminRevokeSession",
        "parameters": [
          {
            "name": "id",
            "in": "path",
            "required": true,
            "schema": {
              "type": "string",
              "format": "uuid"
            }
          }
        ],
        "responses": {
          "204": {
            "description": "No Content"
          },
          "404": {
            "description": "Not Found"
          }
        }
      }
    },
    "/api/v1/nodes": {
      "get": {
        "tags": [
          "Files"
        ],
        "description": "The items in a folder, or at the top of My files when folderId is left out.",
        "operationId": "ListFolder",
        "parameters": [
          {
            "name": "folderId",
            "in": "query",
            "schema": {
              "type": "string",
              "format": "uuid"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "OK",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/FolderListing"
                }
              }
            }
          }
        }
      }
    },
    "/api/v1/nodes/{id}": {
      "get": {
        "tags": [
          "Files"
        ],
        "operationId": "GetNode",
        "parameters": [
          {
            "name": "id",
            "in": "path",
            "required": true,
            "schema": {
              "type": "string",
              "format": "uuid"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "OK",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/NodeDetails"
                }
              }
            }
          }
        }
      }
    },
    "/api/v1/folders": {
      "post": {
        "tags": [
          "Files"
        ],
        "operationId": "CreateFolder",
        "requestBody": {
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/CreateFolderRequest"
              }
            }
          },
          "required": true
        },
        "responses": {
          "201": {
            "description": "Created",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/NodeDto"
                }
              }
            }
          }
        }
      }
    },
    "/api/v1/nodes/{id}/rename": {
      "post": {
        "tags": [
          "Files"
        ],
        "operationId": "RenameNode",
        "parameters": [
          {
            "name": "id",
            "in": "path",
            "required": true,
            "schema": {
              "type": "string",
              "format": "uuid"
            }
          }
        ],
        "requestBody": {
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/RenameRequest"
              }
            }
          },
          "required": true
        },
        "responses": {
          "200": {
            "description": "OK",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/NodeDto"
                }
              }
            }
          }
        }
      }
    },
    "/api/v1/nodes/{id}/move": {
      "post": {
        "tags": [
          "Files"
        ],
        "operationId": "MoveNode",
        "parameters": [
          {
            "name": "id",
            "in": "path",
            "required": true,
            "schema": {
              "type": "string",
              "format": "uuid"
            }
          }
        ],
        "requestBody": {
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/MoveRequest"
              }
            }
          },
          "required": true
        },
        "responses": {
          "200": {
            "description": "OK",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/NodeDto"
                }
              }
            }
          }
        }
      }
    },
    "/api/v1/nodes/{id}/content": {
      "get": {
        "tags": [
          "Files"
        ],
        "description": "The original bytes, as an attachment. Supports ranges. Audited, unlike previews.",
        "operationId": "DownloadFile",
        "parameters": [
          {
            "name": "id",
            "in": "path",
            "required": true,
            "schema": {
              "type": "string",
              "format": "uuid"
            }
          },
          {
            "name": "versionId",
            "in": "query",
            "schema": {
              "type": "string",
              "format": "uuid"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "OK"
          }
        }
      }
    },
    "/api/v1/nodes/{id}/thumbnail": {
      "get": {
        "tags": [
          "Files"
        ],
        "description": "A WebP thumbnail of the file: small (256 px) for lists, medium (640 px) for the grid. 404 until the worker has made one; see NodeDto.thumbnail.",
        "operationId": "GetThumbnail",
        "parameters": [
          {
            "name": "id",
            "in": "path",
            "required": true,
            "schema": {
              "type": "string",
              "format": "uuid"
            }
          },
          {
            "name": "versionId",
            "in": "query",
            "schema": {
              "type": "string",
              "format": "uuid"
            }
          },
          {
            "name": "size",
            "in": "query",
            "schema": {
              "type": "string"
            }
          }
        ],
        "responses": {
          "404": {
            "description": "Not Found"
          }
        }
      }
    },
    "/api/v1/nodes/{id}/preview": {
      "get": {
        "tags": [
          "Files"
        ],
        "description": "What the viewer shows: a WebP for images browsers can't display or that are huge, otherwise the original bytes, inline. Supports ranges. Not audited, unlike downloads (§18).",
        "operationId": "GetPreview",
        "parameters": [
          {
            "name": "id",
            "in": "path",
            "required": true,
            "schema": {
              "type": "string",
              "format": "uuid"
            }
          },
          {
            "name": "versionId",
            "in": "query",
            "schema": {
              "type": "string",
              "format": "uuid"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "OK"
          }
        }
      }
    },
    "/api/v1/nodes/{id}/versions": {
      "get": {
        "tags": [
          "Files"
        ],
        "operationId": "ListVersions",
        "parameters": [
          {
            "name": "id",
            "in": "path",
            "required": true,
            "schema": {
              "type": "string",
              "format": "uuid"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "OK",
            "content": {
              "application/json": {
                "schema": {
                  "type": "array",
                  "items": {
                    "$ref": "#/components/schemas/VersionDto"
                  }
                }
              }
            }
          }
        }
      }
    },
    "/api/v1/nodes/{id}/versions/{versionId}/restore": {
      "post": {
        "tags": [
          "Files"
        ],
        "operationId": "RestoreVersion",
        "parameters": [
          {
            "name": "id",
            "in": "path",
            "required": true,
            "schema": {
              "type": "string",
              "format": "uuid"
            }
          },
          {
            "name": "versionId",
            "in": "path",
            "required": true,
            "schema": {
              "type": "string",
              "format": "uuid"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "OK",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/VersionDto"
                }
              }
            }
          }
        }
      }
    },
    "/api/v1/nodes/{id}/versions/{versionId}/keep-forever": {
      "put": {
        "tags": [
          "Files"
        ],
        "operationId": "SetKeepForever",
        "parameters": [
          {
            "name": "id",
            "in": "path",
            "required": true,
            "schema": {
              "type": "string",
              "format": "uuid"
            }
          },
          {
            "name": "versionId",
            "in": "path",
            "required": true,
            "schema": {
              "type": "string",
              "format": "uuid"
            }
          }
        ],
        "requestBody": {
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/KeepForeverRequest"
              }
            }
          },
          "required": true
        },
        "responses": {
          "200": {
            "description": "OK",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/VersionDto"
                }
              }
            }
          }
        }
      }
    },
    "/api/v1/uploads/check": {
      "post": {
        "tags": [
          "Files"
        ],
        "description": "Run before uploading: which of these files (by SHA-256) the user already has.",
        "operationId": "CheckDuplicates",
        "requestBody": {
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/DuplicateCheckRequest"
              }
            }
          },
          "required": true
        },
        "responses": {
          "200": {
            "description": "OK",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/DuplicateCheckResponse"
                }
              }
            }
          }
        }
      }
    },
    "/api/v1/uploads/copy": {
      "post": {
        "tags": [
          "Files"
        ],
        "description": "Upload anyway: adds a file with content the user already has, without sending the bytes.",
        "operationId": "CopyFromContent",
        "requestBody": {
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/CopyFromContentRequest"
              }
            }
          },
          "required": true
        },
        "responses": {
          "201": {
            "description": "Created",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/NodeDto"
                }
              }
            }
          }
        }
      }
    },
    "/api/v1/storage": {
      "get": {
        "tags": [
          "Files"
        ],
        "operationId": "GetStorage",
        "responses": {
          "200": {
            "description": "OK",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/StorageUsage"
                }
              }
            }
          }
        }
      }
    },
    "/api/v1/uploads/{id}": {
      "get": {
        "tags": [
          "Uploads"
        ],
        "description": "The state of a tus upload, and once complete, the file it produced and any duplicates of it.",
        "operationId": "GetUpload",
        "parameters": [
          {
            "name": "id",
            "in": "path",
            "required": true,
            "schema": {
              "type": "string",
              "format": "uuid"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "OK",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/UploadStatus"
                }
              }
            }
          }
        }
      }
    }
  },
  "components": {
    "schemas": {
      "AuthConfig": {
        "required": [
          "enabled",
          "providerName"
        ],
        "type": "object",
        "properties": {
          "enabled": {
            "type": "boolean"
          },
          "providerName": {
            "type": [
              "null",
              "string"
            ]
          }
        }
      },
      "CopyFromContentRequest": {
        "required": [
          "folderId",
          "name",
          "sha256",
          "clientModifiedAt"
        ],
        "type": "object",
        "properties": {
          "folderId": {
            "type": [
              "null",
              "string"
            ],
            "format": "uuid"
          },
          "name": {
            "type": "string"
          },
          "sha256": {
            "type": "string"
          },
          "clientModifiedAt": {
            "type": [
              "null",
              "string"
            ],
            "format": "date-time"
          },
          "onConflict": {
            "$ref": "#/components/schemas/NameConflictPolicy"
          }
        }
      },
      "CreateFolderRequest": {
        "required": [
          "folderId",
          "name"
        ],
        "type": "object",
        "properties": {
          "folderId": {
            "type": [
              "null",
              "string"
            ],
            "format": "uuid"
          },
          "name": {
            "type": "string"
          }
        }
      },
      "CurrentSession": {
        "required": [
          "user",
          "sessionId",
          "csrfToken"
        ],
        "type": "object",
        "properties": {
          "user": {
            "$ref": "#/components/schemas/UserProfile"
          },
          "sessionId": {
            "type": "string",
            "format": "uuid"
          },
          "csrfToken": {
            "type": [
              "null",
              "string"
            ]
          }
        }
      },
      "DuplicateCheckItem": {
        "required": [
          "name",
          "size",
          "sha256"
        ],
        "type": "object",
        "properties": {
          "name": {
            "type": "string"
          },
          "size": {
            "type": "integer",
            "format": "int64"
          },
          "sha256": {
            "type": "string"
          }
        }
      },
      "DuplicateCheckRequest": {
        "required": [
          "files"
        ],
        "type": "object",
        "properties": {
          "files": {
            "type": "array",
            "items": {
              "$ref": "#/components/schemas/DuplicateCheckItem"
            }
          }
        }
      },
      "DuplicateCheckResponse": {
        "required": [
          "files"
        ],
        "type": "object",
        "properties": {
          "files": {
            "type": "array",
            "items": {
              "$ref": "#/components/schemas/DuplicateCheckResult"
            }
          }
        }
      },
      "DuplicateCheckResult": {
        "required": [
          "sha256",
          "duplicates"
        ],
        "type": "object",
        "properties": {
          "sha256": {
            "type": "string"
          },
          "duplicates": {
            "type": "array",
            "items": {
              "$ref": "#/components/schemas/DuplicateMatch"
            }
          }
        }
      },
      "DuplicateMatch": {
        "required": [
          "nodeId",
          "name",
          "path",
          "inTrash"
        ],
        "type": "object",
        "properties": {
          "nodeId": {
            "type": "string",
            "format": "uuid"
          },
          "name": {
            "type": "string"
          },
          "path": {
            "type": "array",
            "items": {
              "$ref": "#/components/schemas/PathEntry"
            }
          },
          "inTrash": {
            "type": "boolean"
          }
        }
      },
      "FolderListing": {
        "required": [
          "folder",
          "path",
          "items"
        ],
        "type": "object",
        "properties": {
          "folder": {
            "oneOf": [
              {
                "type": "null"
              },
              {
                "$ref": "#/components/schemas/NodeDto"
              }
            ]
          },
          "path": {
            "type": "array",
            "items": {
              "$ref": "#/components/schemas/PathEntry"
            }
          },
          "items": {
            "type": "array",
            "items": {
              "$ref": "#/components/schemas/NodeDto"
            }
          }
        }
      },
      "KeepForeverRequest": {
        "required": [
          "keepForever"
        ],
        "type": "object",
        "properties": {
          "keepForever": {
            "type": "boolean"
          }
        }
      },
      "MoveRequest": {
        "required": [
          "folderId"
        ],
        "type": "object",
        "properties": {
          "folderId": {
            "type": [
              "null",
              "string"
            ],
            "format": "uuid"
          }
        }
      },
      "NameConflictPolicy": {
        "enum": [
          "fail",
          "keepBoth",
          "newVersion"
        ],
        "default": "fail"
      },
      "NodeDetails": {
        "required": [
          "node",
          "path"
        ],
        "type": "object",
        "properties": {
          "node": {
            "$ref": "#/components/schemas/NodeDto"
          },
          "path": {
            "type": "array",
            "items": {
              "$ref": "#/components/schemas/PathEntry"
            }
          }
        }
      },
      "NodeDto": {
        "required": [
          "id",
          "parentId",
          "kind",
          "name",
          "size",
          "mimeType",
          "sha256",
          "ownerId",
          "ownerName",
          "createdAt",
          "modifiedAt",
          "currentVersionId",
          "versionNumber",
          "thumbnail"
        ],
        "type": "object",
        "properties": {
          "id": {
            "type": "string",
            "format": "uuid"
          },
          "parentId": {
            "type": [
              "null",
              "string"
            ],
            "format": "uuid"
          },
          "kind": {
            "$ref": "#/components/schemas/NodeKind"
          },
          "name": {
            "type": "string"
          },
          "size": {
            "type": [
              "null",
              "integer"
            ],
            "format": "int64"
          },
          "mimeType": {
            "type": [
              "null",
              "string"
            ]
          },
          "sha256": {
            "type": [
              "null",
              "string"
            ]
          },
          "ownerId": {
            "type": "string",
            "format": "uuid"
          },
          "ownerName": {
            "type": "string"
          },
          "createdAt": {
            "type": "string",
            "format": "date-time"
          },
          "modifiedAt": {
            "type": "string",
            "format": "date-time"
          },
          "currentVersionId": {
            "type": [
              "null",
              "string"
            ],
            "format": "uuid"
          },
          "versionNumber": {
            "type": [
              "null",
              "integer"
            ],
            "format": "int32"
          },
          "thumbnail": {
            "$ref": "#/components/schemas/ThumbnailState"
          }
        }
      },
      "NodeKind": {
        "enum": [
          "folder",
          "file"
        ]
      },
      "PathEntry": {
        "required": [
          "id",
          "name"
        ],
        "type": "object",
        "properties": {
          "id": {
            "type": "string",
            "format": "uuid"
          },
          "name": {
            "type": "string"
          }
        }
      },
      "RenameRequest": {
        "required": [
          "name"
        ],
        "type": "object",
        "properties": {
          "name": {
            "type": "string"
          }
        }
      },
      "ServerInfo": {
        "required": [
          "name",
          "version"
        ],
        "type": "object",
        "properties": {
          "name": {
            "type": "string"
          },
          "version": {
            "type": "string"
          }
        }
      },
      "SessionInfo": {
        "required": [
          "id",
          "kind",
          "deviceName",
          "createdAt",
          "lastSeenAt",
