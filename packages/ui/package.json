{
  "name": "@dokument/ui",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "description": "Web UI components (docs/design.md §16.4) with Storybook and the clickable mockup (§16.5). Web only: mobile shares tokens, not components.",
  "exports": {
    ".": "./src/index.ts",
    "./styles.css": "./src/styles.css"
  },
  "scripts": {
    "dev": "storybook dev -p 6006 --no-open",
    "build": "storybook build --quiet -o dist/storybook",
    "lint": "eslint .",
    "typecheck": "tsc -p tsconfig.json"
  },
  "dependencies": {
    "@dokument/core": "workspace:*",
    "@dokument/i18n": "workspace:*",
    "@dokument/tokens": "workspace:*",
    "@fontsource/albert-sans": "5.3.0",
    "@fontsource/ibm-plex-mono": "5.3.0",
    "material-symbols": "0.48.1",
    "radix-ui": "1.8.1",
    "react-i18next": "17.1.0"
  },
  "peerDependencies": {
    "react": "^19",
    "react-dom": "^19"
  },
  "devDependencies": {
    "@storybook/addon-a11y": "10.6.2",
    "@storybook/react-vite": "10.6.2",
    "@tailwindcss/vite": "4.3.3",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "@vitejs/plugin-react": "6.1.2",
    "i18next": "26.5.4",
    "react": "19.3.1",
    "react-dom": "19.3.1",
    "storybook": "10.6.2",
    "tailwindcss": "4.3.3",
    "vite": "8.3.5"
  }
