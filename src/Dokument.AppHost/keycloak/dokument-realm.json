{
  "realm": "dokument",
  "displayName": "Dokumentsystem (dev)",
  "enabled": true,
  "sslRequired": "none",
  "registrationAllowed": false,
  "groups": [{ "name": "dokument-users" }, { "name": "dokument-admins" }],
  "clients": [
    {
      "clientId": "dokument",
      "name": "Dokumentsystem",
      "enabled": true,
      "protocol": "openid-connect",
      "publicClient": false,
      "clientAuthenticatorType": "client-secret",
      "secret": "dokument-dev-secret",
      "standardFlowEnabled": true,
      "directAccessGrantsEnabled": false,
      "implicitFlowEnabled": false,
      "redirectUris": ["http://localhost:5173/api/v1/auth/callback"],
      "webOrigins": ["http://localhost:5173"],
      "attributes": { "pkce.code.challenge.method": "S256" },
      "protocolMappers": [
        {
          "name": "groups",
          "protocol": "openid-connect",
          "protocolMapper": "oidc-group-membership-mapper",
          "config": {
            "claim.name": "groups",
            "full.path": "false",
            "id.token.claim": "true",
            "access.token.claim": "false",
            "userinfo.token.claim": "true"
          }
        }
      ]
    }
  ],
  "users": [
    {
      "username": "alice",
      "email": "alice@example.com",
      "emailVerified": true,
      "firstName": "Alice",
      "lastName": "Andersson",
      "enabled": true,
      "credentials": [{ "type": "password", "value": "alice", "temporary": false }],
      "groups": ["dokument-admins"]
    },
    {
      "username": "bob",
      "email": "bob@example.com",
      "emailVerified": true,
      "firstName": "Bob",
      "lastName": "Berg",
      "enabled": true,
      "credentials": [{ "type": "password", "value": "bob", "temporary": false }],
      "groups": ["dokument-users"]
    },
    {
      "username": "carol",
      "email": "carol@example.com",
      "emailVerified": true,
      "firstName": "Carol",
      "lastName": "Carlsson",
      "enabled": true,
      "credentials": [{ "type": "password", "value": "carol", "temporary": false }]
    }
  ]
}
