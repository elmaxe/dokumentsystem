<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <!-- LibraryImport (PDFium) generates unsafe marshalling code. -->
    <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
  </PropertyGroup>
  <ItemGroup>
    <FrameworkReference Include="Microsoft.AspNetCore.App" />
  </ItemGroup>
  <ItemGroup>
    <ProjectReference Include="..\Dokument.Infrastructure\Dokument.Infrastructure.csproj" />
  </ItemGroup>
  <ItemGroup>
    <PackageReference Include="NetVips" />
    <!-- The Docker image sets UseSystemLibvips and installs Ubuntu's libvips with the HEVC plugin instead: the bundled
         build can't decode iPhone HEIC photos. -->
    <PackageReference Include="NetVips.Native" Condition="'$(UseSystemLibvips)' != 'true'" />
    <PackageReference Include="bblanchon.PDFium" />
  </ItemGroup>
  <ItemGroup>
    <InternalsVisibleTo Include="Dokument.UnitTests" />
  </ItemGroup>
</Project>
