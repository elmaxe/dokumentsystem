# Copy to .env next to docker-compose.yml and adjust. See docs/design.md §4.

# Image tag. "edge" follows the main branch; pin a release tag once one exists.
DOKUMENT_VERSION=edge

# Port on the NAS. Put a reverse proxy with TLS (Caddy, Traefik, Nginx Proxy Manager) in front of it.
DOKUMENT_PORT=8080
# The address people use to reach Dokumentsystem, e.g. https://docs.example.com
PUBLIC_URL=

# Your NAS user and group ids (`id` on the NAS shows them). Files are written as this user.
PUID=1000
PGID=1000
TZ=Europe/Stockholm

# Precious: the originals. Back this up.
ORIGINALS_LOCATION=./data/originals
# Regenerable: thumbnails and previews.
DERIVED_LOCATION=./data/derived
# Database dumps.
BACKUP_LOCATION=./data/backups
# Database files. Must be on a local disk, not a network share.
DB_DATA_LOCATION=./postgres

DB_USERNAME=dokument
DB_DATABASE=dokument
# Use a long random value, e.g. from `openssl rand -hex 24`.
DB_PASSWORD=
