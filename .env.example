# Copy to .env next to docker-compose.yml and adjust. See docs/design.md §4.

# Image tag. "edge" follows the main branch; pin a release tag once one exists.
DOKUMENT_VERSION=edge

# Port on the NAS. Put a reverse proxy with TLS (Caddy, Traefik, Nginx Proxy Manager) in front of it.
DOKUMENT_PORT=8080
# The address people use to reach Dokumentsystem, e.g. https://docs.example.com
PUBLIC_URL=
# The reverse proxy's address or network, e.g. 172.16.0.0/12 for a proxy in another Docker container. Without it
# everyone shares the proxy's address, so they share one rate limit and the audit log shows the proxy.
TRUSTED_PROXIES=

# Sign-in through your identity provider (Authentik, Authelia, Keycloak, Pocket ID, …). See docs/design.md §5.
# Register a confidential client with the redirect URI ${PUBLIC_URL}/api/v1/auth/callback.
OIDC_ISSUER=
OIDC_CLIENT_ID=
OIDC_CLIENT_SECRET=
# Shown on the sign-in button, e.g. "Authentik".
OIDC_PROVIDER_NAME=
# Optional: only members of this IdP group may sign in. Members of OIDC_ADMIN_GROUP become admins.
OIDC_USER_GROUP=
OIDC_ADMIN_GROUP=dokument-admins
# Add "groups" for IdPs that only send groups when asked, such as Authelia.
OIDC_SCOPE=openid profile email
# Optional: a claim that sets each person's storage at sign-in, such as 50GB, 1.5TiB, a byte count or "unlimited".
# GB and GiB both mean 1024³ bytes. While it is set, the admin page can't change those people's storage (§17.1).
OIDC_QUOTA_CLAIM=

# Optional: the claim with each person's profile picture, a URL the server downloads at sign-in (§5.1).
# Leave it commented out for the standard "picture" claim; set it empty to turn profile pictures off.
# OIDC_PICTURE_CLAIM=picture

# Optional: send traces, metrics and logs to an OpenTelemetry backend (a Collector, Grafana Alloy, SigNoz, the
# Aspire dashboard, …) over OTLP/gRPC, e.g. http://collector:4317. Nothing is sent while this is empty. See
# docs/design.md §22.1; for a Prometheus /metrics endpoint, set METRICS_PORT on the server and worker services.
OTEL_EXPORTER_OTLP_ENDPOINT=
OTEL_EXPORTER_OTLP_HEADERS=

# Your NAS user and group ids (`id` on the NAS shows them). Files are written as this user.
PUID=1000
PGID=1000
TZ=Europe/Stockholm

# Precious: the originals. Back this up.
ORIGINALS_LOCATION=./data/originals
# Regenerable: thumbnails and previews.
DERIVED_LOCATION=./data/derived
# Database dumps.
BACKUP_LOCATION=./data/backups
# Database files. Must be on a local disk, not a network share.
DB_DATA_LOCATION=./postgres

DB_USERNAME=dokument
DB_DATABASE=dokument
# Use a long random value, e.g. from `openssl rand -hex 24`.
DB_PASSWORD=
