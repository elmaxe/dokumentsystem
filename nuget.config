<?xml version="1.0" encoding="utf-8"?>
<!-- Restores only from nuget.org, whatever feeds are in your user-level NuGet config.
     Central package management requires one source or a source mapping (NU1507). -->
<configuration>
  <packageSources>
    <clear />
    <add key="nuget.org" value="https://api.nuget.org/v3/index.json" protocolVersion="3" />
  </packageSources>
  <packageSourceMapping>
    <clear />
    <packageSource key="nuget.org">
      <package pattern="*" />
    </packageSource>
  </packageSourceMapping>
</configuration>
